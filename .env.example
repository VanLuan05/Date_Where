# Firebase Configuration Template
# ════════════════════════════════════════════════════════════════
# Sao chép file này thành `.env` và điền thông tin dự án Firebase
# của bạn vào đây. File `.env` đã được thêm vào .gitignore để
# đảm bảo credentials KHÔNG bao giờ bị đẩy lên GitHub.
#
# Cách lấy thông tin: Firebase Console → Project Settings →
#   Your apps → Web app → Config
# ════════════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=AIzaSy_your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ════════════════════════════════════════════════════════════════
# Để Deploy lên GitHub Pages (tự động qua GitHub Actions):
#   Vào repo → Settings → Secrets and variables → Actions
#   Tạo các secret tương ứng với tên biến bên trên.
# ════════════════════════════════════════════════════════════════
